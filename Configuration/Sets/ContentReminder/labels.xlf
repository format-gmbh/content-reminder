				<source>Sender address</source>
			</trans-unit>
			<trans-unit id="settings.description.contentReminder.mail.fromAddress">
				<source>Empty = default sender of the installation (MAIL.defaultMailFromAddress).</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.fromName">
				<source>Sender name</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.unassignedRecipient">
