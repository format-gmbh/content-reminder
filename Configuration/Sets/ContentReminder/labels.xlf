		<header/>
		<body>
			<trans-unit id="label">
				<source>Content Reminder</source>
			</trans-unit>
			<trans-unit id="categories.contentReminder">
				<source>Content Reminder</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.assignableGroups">
				<source>Assignable backend user groups</source>
			</trans-unit>
			<trans-unit id="settings.description.contentReminder.assignableGroups">
				<source>Comma-separated list of be_groups uids. Only members of these groups can be assigned. Empty = all active backend users.</source>
			</trans-unit>
			<trans-unit id="categories.contentReminder.mail">
				<source>Weekly email</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.enabled">
				<source>Send weekly email</source>
			</trans-unit>
			<trans-unit id="settings.description.contentReminder.mail.enabled">
				<source>Requires the scheduler task "content-reminder:send-weekly-mail" running daily.</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday">
				<source>Weekday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.monday">
				<source>Monday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.tuesday">
				<source>Tuesday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.wednesday">
				<source>Wednesday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.thursday">
				<source>Thursday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.friday">
				<source>Friday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.saturday">
				<source>Saturday</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.mail.weekday.enum.sunday">
				<source>Sunday</source>
			</trans-unit>
