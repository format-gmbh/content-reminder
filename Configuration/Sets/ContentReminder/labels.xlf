				<source>Days to look ahead</source>
			</trans-unit>
			<trans-unit id="settings.description.contentReminder.mail.lookaheadDays">
				<source>Reminders due within this number of days are included in addition to overdue ones.</source>
			</trans-unit>
			<trans-unit id="settings.contentReminder.backendUrl">
				<source>Backend URL for links in emails</source>
			</trans-unit>
			<trans-unit id="settings.description.contentReminder.backendUrl">
				<source>Empty = derived from the site base, e.g. https://example.org/typo3</source>
			</trans-unit>
