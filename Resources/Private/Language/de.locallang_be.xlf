				<source>Allows assigning reminders to other backend users and changing the responsible person.</source>
				<target>Erlaubt, Erinnerungen anderen Backend-Benutzern zuzuweisen und die Zuständigkeit zu ändern.</target>
			</trans-unit>
			<trans-unit id="customPermOptions.manageAll" approved="yes">
				<source>Manage all reminders</source>
				<target>Alle Erinnerungen verwalten</target>
			</trans-unit>
