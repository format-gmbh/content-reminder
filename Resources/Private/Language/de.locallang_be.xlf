				<target>Erlaubt, Erinnerungen anderer Personen zu bearbeiten, zu erledigen und zu löschen.</target>
			</trans-unit>
			<trans-unit id="datahandler.error.createNotAllowed" approved="yes">
				<source>You are not allowed to create reminders on page "{page}".</source>
				<target>Sie dürfen auf der Seite „{page}“ keine Erinnerungen anlegen.</target>
			</trans-unit>
